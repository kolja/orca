
{% extends "layout.xml.tera" %}
{% block content %}
  <title>{{ feed_title }}</title>
  {%- for entry in entries %}
  <entry>
    <title>{{ entry.name }}</title>
    <id>urn:orca:{{ lib }}:{{ noun }}:{{ entry.id }}</id>
    <link href="{{ base }}/{{ lib }}/{{ shelf }}/{{ entry.id }}" type="application/atom+xml;profile=opds-catalog;kind=acquisition"/>
    <updated>{{ updated }}</updated>
    <content type="text">{{ entry.books }} book{% if entry.books != 1 %}s{% endif %}</content>
  </entry>
  {%- endfor %}

{% endblock content %}
