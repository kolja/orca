{% extends "layout.xml.tera" %}
{% block content %}
  <title>{{ lib }}</title>
{%- for section in sections %}

  <entry>
    <title>{{ section.title }}</title>
    <id>urn:orca:{{ lib }}:{{ section.id }}</id>
    <link href="{{ section.href }}"{% if section.rel %} rel="{{ section.rel }}"{% endif %} type="application/atom+xml;profile=opds-catalog;kind={{ section.kind }}"/>
    <updated>{{ updated }}</updated>
    <content type="text">{{ section.content }}</content>
  </entry>
{%- endfor %}
{% endblock content %}
